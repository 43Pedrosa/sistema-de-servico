# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Public Supabase settings used by the browser.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Server-only API settings. Never prefix service-role or sb_secret_ keys with VITE_.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Standalone administrator credentials; generate the hash with npm run admin:set-password.
ADMIN_USERNAME="MINHALOJA2026"
ADMIN_PASSWORD_HASH=""
# Private HMAC signing key for HttpOnly admin session cookies. Generated by the setup script.
ADMIN_SESSION_SECRET=""
# Optional:
# ADMIN_DISPLAY_NAME="Gerência"
